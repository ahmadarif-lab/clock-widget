<?xml version="1.0" encoding="utf-8"?>
<!-- Flip-clock face: three off-white cards (hh / mm / ss) over a violet-to-olive diagonal glow.
     Measured from the reference at 3.7 px/dp (card 64 x 80 dp, gap 11 dp). Every card is a bitmap
     drawn by FlipCardRenderer, so it can flip in 3D; ClockTickService feeds the frames. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_flip"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/flip_h"
        android:layout_width="64dp"
        android:layout_height="80dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/flip_m"
        android:layout_width="64dp"
        android:layout_height="80dp"
        android:layout_marginStart="11dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/flip_s"
        android:layout_width="64dp"
        android:layout_height="80dp"
        android:layout_marginStart="11dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

</LinearLayout>
