<?xml version="1.0" encoding="utf-8"?>
<!-- Green LED face. Each big digit is a vector 7-segment drawable (lit segments over dim
     "ghost" segments) whose image level 0-9 is set by ClockWidgetProvider; AM/PM + battery sit
     on the left, day / month on the right. Geometry measured from the reference at 4.8 px/dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- left column: AM/PM + battery (glyphs are 7-segment vectors, see tools/gen_glyphs.py) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/led_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:src="@drawable/seg_pm" />

        <ImageView
            android:id="@+id/led_battery"
            android:layout_width="15dp"
            android:layout_height="7dp"
            android:layout_marginTop="5dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/led_battery" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/led_pct0"
                android:layout_width="4.5dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />

            <ImageView
                android:id="@+id/led_pct1"
                android:layout_width="4.5dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />

            <ImageView
                android:id="@+id/led_pct2"
                android:layout_width="4.5dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/led_h0"
        android:layout_width="38dp"
        android:layout_height="68dp"
        android:layout_marginStart="9dp"
        android:contentDescription="@null"
        android:src="@drawable/led_digit" />

    <ImageView
        android:id="@+id/led_h1"
        android:layout_width="38dp"
        android:layout_height="68dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/led_digit" />

    <!-- colon: two round dots -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:contentDescription="@null"
            android:src="@drawable/dot_led" />

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="21dp"
            android:contentDescription="@null"
            android:src="@drawable/dot_led" />
    </LinearLayout>

    <ImageView
        android:id="@+id/led_m0"
        android:layout_width="38dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:src="@drawable/led_digit" />

    <ImageView
        android:id="@+id/led_m1"
        android:layout_width="38dp"
        android:layout_height="68dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/led_digit" />

    <!-- right column: day / month -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/led_day0"
                android:layout_width="5.7dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />

            <ImageView
                android:id="@+id/led_day1"
                android:layout_width="5.7dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />
        </LinearLayout>

        <ImageView
            android:layout_width="6dp"
            android:layout_height="9dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/seg_slash" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/led_mon0"
                android:layout_width="5.7dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />

            <ImageView
                android:id="@+id/led_mon1"
                android:layout_width="5.7dp"
                android:layout_height="9dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/seg_digit" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
