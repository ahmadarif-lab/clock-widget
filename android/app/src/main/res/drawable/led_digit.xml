<?xml version="1.0" encoding="utf-8"?>
<!-- selects one LED digit by image level (0-9); set from ClockWidgetProvider -->
<level-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/led_d0" android:maxLevel="0" android:minLevel="0" />
    <item android:drawable="@drawable/led_d1" android:maxLevel="1" android:minLevel="1" />
    <item android:drawable="@drawable/led_d2" android:maxLevel="2" android:minLevel="2" />
    <item android:drawable="@drawable/led_d3" android:maxLevel="3" android:minLevel="3" />
    <item android:drawable="@drawable/led_d4" android:maxLevel="4" android:minLevel="4" />
    <item android:drawable="@drawable/led_d5" android:maxLevel="5" android:minLevel="5" />
    <item android:drawable="@drawable/led_d6" android:maxLevel="6" android:minLevel="6" />
    <item android:drawable="@drawable/led_d7" android:maxLevel="7" android:minLevel="7" />
    <item android:drawable="@drawable/led_d8" android:maxLevel="8" android:minLevel="8" />
    <item android:drawable="@drawable/led_d9" android:maxLevel="9" android:minLevel="9" />
</level-list>
